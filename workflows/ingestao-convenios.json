      ],
      "parameters": {
        "operation": "completion",
        "completionTitle": "Base atualizada",
        "completionMessage": "={{ $('Um item por arquivo').all().length }} arquivo(s) indexado(s) em {{ $input.all().length }} trecho(s).",
        "options": {}
      }
    },
    {
