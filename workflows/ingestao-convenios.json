      "name": "Enviar convênios",
      "webhookId": "3c1f6a52-8d0e-4b4f-9a6e-1a0c10000001",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.5,
      "position": [
        0,
        0
      ],
      "parameters": {
        "formTitle": "Base de convênios",
        "formDescription": "Envie os PDFs dos convênios. O envio substitui a base anterior.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Documentos",
              "fieldName": "documentos",
              "fieldType": "file",
              "multipleFiles": true,
              "acceptFileTypes": ".pdf",
              "requiredField": true
            }
          ]
        },
        "options": {
          "path": "base-convenios"
        }
      }
    },
    {
      "id": "56f4be9e-f691-5db2-9fcf-bfaa4c87ba26",
      "name": "Um item por arquivo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// O formulário entrega todos os PDFs num único item (Documentos_0, Documentos_1, ...).\n// Aqui cada arquivo vira um item, com o binário em \"data\" e o nome do arquivo no JSON.\nconst saida = [];\nfor (const item of $input.all()) {\n  for (const chave of Object.keys(item.binary ?? {})) {\n    const arquivo = item.binary[chave];\n    saida.push({ json: { arquivo: arquivo.fileName }, binary: { data: arquivo } });\n  }\n}\nreturn saida;\n"
      }
    },
    {
      "id": "d2ff97d5-34fc-56cc-9245-adf822ce61ba",
      "name": "Extrair texto",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        440,
        0
      ],
      "parameters": {
        "operation": "pdf",
        "options": {}
      }
    },
    {
      "id": "49c2c0f1-8045-521b-acee-bf6d04b9d03b",
      "name": "Inserir na base",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreInMemory",
      "typeVersion": 1.3,
      "position": [
        680,
        0
      ],
      "parameters": {
        "mode": "insert",
        "memoryKey": {
          "__rl": true,
          "mode": "id",
          "value": "convenios"
        },
        "embeddingBatchSize": 50,
        "clearStore": true
      }
    },
    {
      "id": "5fb13a7f-3770-5881-8834-ddc02daad2e3",
      "name": "Base atualizada",
      "webhookId": "3c1f6a52-8d0e-4b4f-9a6e-1a0c10000002",
